# CampusLoop Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/campusloop?retryWrites=true&w=majority
MONGODB_URI=

# Frontend Origin for CORS & Cookies
CLIENT_URL=http://localhost:5173

# Allowed College Email Domains (Comma-separated)
COLLEGE_EMAIL_DOMAINS=college.edu,nit.ac.in,iiit.ac.in,bits-pilani.ac.in,dtu.ac.in

# JWT / Cookie Session Secret
JWT_SECRET=campusloop_development_super_secret_jwt_key_change_in_production_12345
SESSION_EXPIRES_IN=7d

# Razorpay Test Mode Credentials
# Obtain from https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary Credentials (Optional for Phase 4)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
